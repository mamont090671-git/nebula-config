net-name: y-net
dev: nebula2
# Relay-серверы — nebula-IP узлов, через которые клиенты за NAT будут проходить
relay_servers:
  - 192.168.11.101

# Inline CA PEM (base64-encoded, optional)
ca_pem: ""

# Key-based signing public address (optional, for -in-pub)
in_pub: ""

# Путь к внешнему CA-ключу (optional). Если задан, генерация CA пропускается,
# используется существующий ca.key. ca.crt всё равно генерируется.
ca_key_path: ""

lighthouse:
  RU:
    groups: home
    nebula_ip:
      ipv4: 192.168.11.101/24
      ipv6: fd00:1234:5678:b::101/64
    port: '4242'
    public_ip: 138.100.15.25
    am_relay: true
    type: LH

hosts:
  LA-H:
    groups: home
    nebula_ip:
      ipv4: 192.168.11.100/24
      ipv6: fd00:1234:5678:b::100/64
    public_ip: 31.57.105.170
    port: '4242'
    type: HOST
    # ssh_target: user@remote-host:/etc/nebula (optional)
  Gpd4:
    groups: home,ssh,admins
    nebula_ip:
      ipv4: 192.168.11.102/24
      ipv6: fd00:1234:5678:b::102/64
    port: '0'
